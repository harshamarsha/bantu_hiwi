399999999999, 1731.6200000000001, 712.96, 1759.6699999999998]}], "image_bbox": [0.0, 0.0, 1280.0, 1870.0], "page": 9}, {"blocks": [{"polygon": [[49.92, 145.86], [1144.32, 145.86], [1144.32, 1587.6299999999999], [49.92, 1587.6299999999999]], "confidence": 0.9764484760500858, "label": "Table", "raw_label": "Table", "reading_order": 0, "html": "<table border=\"0\">\n<tr>\n<td>-ʔàk-</td>\n<td>kūakā</td>\n<td>: kupasuka.<br/>(車のタイヤ, ボールなどが)張り裂ける, (服が小さすぎて)破れる.<br/>crever, éclater, craquer (pneu, balle, habit trop serré, etc).</td>\n</tr>\n<tr>\n<td></td>\n<td>kūakyā (caus.)</td>\n<td>: kupasula.<br/>張り裂く, 破く.<br/>faire crever, etc.</td>\n</tr>\n<tr>\n<td>-ākà</td>\n<td>bwāka (14)</td>\n<td>: ubishi,-.<br/>口論, もめごと.<br/>dispute, querelle.</td>\n</tr>\n<tr>\n<td></td>\n<td>kūéndā ébwāka</td>\n<td>: kuenda ubishi.<br/>言いあいをする, 口論をする.<br/>se disputer, se quereller.</td>\n</tr>\n<tr>\n<td>-àkā</td>\n<td>mwakā (3)                      myakā (4)</td>\n<td>: mwaka, my-.<br/>年：[pl.]収穫(物).<br/>an, année; [pl.]récolte, produits agricoles.</td>\n</tr>\n<tr>\n<td></td>\n<td>émwakā wawāā</td>\n<td>: mwaka jana.<br/>去年.<br/>l'année passée.</td>\n</tr>\n<tr>\n<td></td>\n<td>onú mwakā</td>\n<td>: hii mwake.<br/>今年.<br/>cette année.</td>\n</tr>\n<tr>\n<td></td>\n<td>émwakā wéshiré</td>\n<td>: mwaka kesho.<br/>来年.<br/>l'année prochaine.</td>\n</tr>\n<tr>\n<td></td>\n<td>émwakā ungéshā</td>\n<td>: syn. du précédent.</td>\n</tr>\n<tr>\n<td></td>\n<td>émwakā ungêmísā</td>\n<td>: mwaka yenyi itafuata.<br/>翌年, 来年.<br/>l'année suivante.</td>\n</tr>\n<tr>\n<td>-ʔákā</td>\n<td>múākā (3)</td>\n<td>: aina ya pongo.<br/>[動]アンティロープの一種(大きい),<br/>esp. d'antilope (céphalophe à dos jaune?).</td>\n</tr>\n<tr>\n<td>-ʔàkā</td>\n<td>múakā (1)</td>\n<td>: taté (wa) mwanamuke.<br/>祖母,<br/>grand-mère.</td>\n</tr>\n<tr>\n<td>-áké</td>\n<td>lwáké (11)</td>\n<td>: kisinde ya kuruka.<br/>[動]ムササビ,<br/>écureuil volant.</td>\n</tr>\n</table>", "skipped": false, "error": false, "bbox": [49.92, 145.86, 1144.32, 1587.6299999999999]}, {"polygon": [[544.0, 1735.3600000000001], [643.84, 1735.3600000000001], [643.84, 1765.28], [544.0, 1765.28]], "confidence": 0.9764484760500858, "label": "PageFooter", "raw_label": "Page-Footer", "reading_order": 1, "html": "<p>- 11 -</p>", "skipped": false, "error": false, "bbox": [544.0, 1735.3600000000001, 643.84, 1765.28]}], "image_bbox": [0.0, 0.0, 1280.0, 1870.0], "page": 10}]}