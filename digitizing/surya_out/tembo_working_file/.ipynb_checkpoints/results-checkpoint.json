{"tembo_working_file": [{"blocks": [{"polygon": [[108.80000000000001, 157.08], [1194.24, 157.08], [1194.24, 1625.03], [108.80000000000001, 1625.03]], "confidence": 0.9737126822681187, "label": "Table", "raw_label": "Table", "reading_order": 0, "html": "<table border=\"0\">\n<tr>\n<td>-à<sup>2-3</sup></td>\n<td>kwââná</td>\n<td>: kuonekana kwa muzimu.<br/>(死者の霊が)現れる。<br/>hanter, apparaître (esprit).</td>\n</tr>\n<tr>\n<td>kwâânyá (caus.)</td>\n<td>: kuonesha muzimu.<br/>(死者の霊を)呼び起す。<br/>favoriser l'apparition des esprits.</td>\n</tr>\n<tr>\n<td>kwâânwá (pass.)</td>\n<td>: kuona muzimu, kukamatiwa na muzimu.<br/>死者の霊を見る, 死者の霊にとりつかれる。<br/>voir un esprit, être possédé.</td>\n</tr>\n<tr>\n<td>-à<sup>2-4</sup></td>\n<td>kwââsá (+caus.)</td>\n<td>: kutokulipa deni.<br/>借金を返さない, 踏み倒す。<br/>laisser ses dettes impayées.</td>\n</tr>\n<tr>\n<td>mwaasa (1)</td>\n<td>baasa (2)</td>\n<td>: mutu mwenyi halipake deni.<br/>なかなか借金を返さない人, 踏み倒す人。<br/>celui qui laisse ses dettes impayées.</td>\n</tr>\n<tr>\n<td>bwaasa (14)</td>\n<td>: hali ya kutokulipa deni.<br/>借金を返さないこと, 踏み倒すこと。<br/>état de laisser ses dettes impayées.</td>\n</tr>\n<tr>\n<td>-à<sup>2-5</sup></td>\n<td>kwââsá (+caus.)</td>\n<td>: kukutanisha lipondo.<br/>たまたまカニをつかまえる(川へ洗濯, 水あびに<br/>行ったときなど)。<br/>trouver par hasard un crabe dans une rivière.</td>\n</tr>\n<tr>\n<td>-à<sup>2-6</sup></td>\n<td>kwââká</td>\n<td>: kukimbilia.<br/>(〜に)逃げ込む。<br/>se sauver, se réfugier dans.</td>\n</tr>\n<tr>\n<td>-à<sup>2-7</sup></td>\n<td>kú<sup>a</sup>âmúkwá (+pass.)</td>\n<td>: kupata ndoto ya kusemasema.<br/>ねぼける, 夢遊病者的に振舞う。<br/>agir en somnambule.</td>\n</tr>\n<tr>\n<td>-àà</td>\n<td>caa (7)</td>\n<td>byaa (8)</td>\n<td>: -kosa, ma-; zambi, -.<br/>罪, 過失。<br/>faute, crime, péché.</td>\n</tr>\n<tr>\n<td>kúkolá (~ kúfrá) écaa</td>\n<td>: kufanya kosa.<br/>罪を犯す。<br/>commettre une faute, etc.</td>\n</tr>\n<tr>\n<td>-àâ</td>\n<td>ciáa (7)</td>\n<td>biáa (8)</td>\n<td>: mafafa, -.<br/>肺。<br/>poumon.</td>\n</tr>\n<tr>\n<td>-áb<sup>-1</sup></td>\n<td>kwábábá</td>\n<td>: kutoa sauti ya kilio, kulalamika.<br/>助けを求めて叫ぶ。<br/>crier au secours.</td>\n</tr>\n</table>", "skipped": false, "error": false, "bbox": [108.80000000000001, 157.08, 1194.24, 1625.03]}, {"polygon": [[601.5999999999999, 1748.45], [697.6, 1748.45], [697.6, 1785.85], [601.5999999999999, 1785.85]], "confidence": 0.9737126822681187, "label": "PageFooter", "raw_label": "Page-Footer", "reading_order": 1, "html": "<p>— 2 —</p>", "skipped": false, "error": false, "bbox": [601.5999999999999, 1748.45, 697.6, 1785.85]}], "image_bbox": [0.0, 0.0, 1280.0, 1870.0], "page": 1}, {"blocks": [{"polygon": [[78.08, 147.73], [1172.48, 147.73], [1172.48, 1705.44], [78.08, 1705.44]], "confidence": 0.9886486308239314, "label": "Table", "raw_label": "Table", "reading_order": 0, "html": "<table border=\"0\">\n<tr>\n<td></td>\n<td>kābābō (12)</td>\n<td>tswābābō (13)</td>\n<td>: sauti ya kilio.<br/>助けを求める叫び声。<br/>cri au secours.</td>\n</tr>\n<tr>\n<td>-āb<sup>-2</sup></td>\n<td>kwābīrīrā</td>\n<td></td>\n<td>: kupokea.<br/>走っていって抱きつく。<br/>sauter dans les bras de qn.</td>\n</tr>\n<tr>\n<td>-āb<sup>-3</sup></td>\n<td>kwābūkā</td>\n<td></td>\n<td>: kusahau, kukosa.<br/>間違う, 失敗する。<br/>se tromper (de route, dans un calcul), subir un échec.</td>\n</tr>\n<tr>\n<td></td>\n<td>kwābūsā (caus.)</td>\n<td></td>\n<td>: kusahaulisha, kukosesha.<br/>間違わせる, 失敗させる。<br/>tromper, tricher.</td>\n</tr>\n<tr>\n<td></td>\n<td>mwābūsī (1)</td>\n<td>bābūsī (2)</td>\n<td>: mudanganyifu, ba-; mukorofi, ba-.<br/>ごまかす人, いかさま師。<br/>trompeur, tricheur.</td>\n</tr>\n<tr>\n<td>-āb<sup>-4</sup></td>\n<td>kwābūlā</td>\n<td></td>\n<td>: kupiga ngufu.<br/>強く叩く。<br/>battre fort.</td>\n</tr>\n<tr>\n<td>-āb<sup>-5</sup></td>\n<td>kwābūlā</td>\n<td></td>\n<td>: kutosha sehemu fulani ku maiti kwa kuloga.<br/>呪術のために死体の一部を切り取る。<br/>arracher ou couper un morceau d'un cadavre<br/>pour sorcellerie.</td>\n</tr>\n<tr>\n<td>-āb<sup>-6</sup></td>\n<td>kwābūlā</td>\n<td></td>\n<td>: kuchunga nyama.<br/>家畜の番をする。<br/>garder le bétail.</td>\n</tr>\n<tr>\n<td></td>\n<td>mwābūsī (1)</td>\n<td>bābūsī (2)</td>\n<td>: muchungaji wa nyama, ba-.<br/>家畜の番人。<br/>celui qui garde le bétail (berger, bouvier, etc.).</td>\n</tr>\n<tr>\n<td>-āb<sup>-</sup></td>\n<td>kwābīrā</td>\n<td></td>\n<td>: kushinda ngufu.<br/>打ち負かす, 人の能力を越える。<br/>vaincre, dépasser la force de qn.</td>\n</tr>\n<tr>\n<td></td>\n<td>kwābīrwā (pass.)</td>\n<td></td>\n<td>: kushindwa.<br/>持て余す, 策がつきる。<br/>être vaincu, être à bout.</td>\n</tr>\n<tr>\n<td></td>\n<td>kwābīrībwā (pass.)</td>\n<td></td>\n<td>: syn. du précédent.</td>\n</tr>\n<tr>\n<td></td>\n<td>kwābīrānā</td>\n<td></td>\n<td>: kushindikana.<br/>御し難い, 従順でない。<br/>être indocile, ne pas obéir.</td>\n</tr>\n<tr>\n<td>-ʔāb<sup>-1</sup></td>\n<td>kūābā</td>\n<td></td>\n<td>: kugawanya.<br/>分ける, 分配する。<br/>partager, diviser, distribuer.</td>\n</tr>\n</table>", "skipped": false, "error": false, "bbox": [78.08, 147.73, 1172.48, 1705.44]}, {"polygon": [[573.44, 1740.97], [672.0, 1740.97], [672.0, 1769.02], [573.44, 1769.02]], "confidence": 0.9886486308239314, "label": "PageFooter", "raw_label": "Page-Footer", "reading_order": 1, "html": "<p>- 3 -</p>", "skipped": false, "error": false, "bbox": [573.44, 1740.97, 672.0, 1769.02]}], "image_bbox": [0.0, 0.0, 1280.0, 1870.0], "page": 2}, {"blocks": [{"polygon": [[110.07999999999998, 153.34], [1199.3600000000001, 153.34], [1199.3600000000001, 1649.34], [110.07999999999998, 1649.34]], "confidence": 0.9836030306882633, "label": "Table", "raw_label": "Table", "reading_order": 0, "html": "<table border=\"0\">\n<tr>\n<td>múábí (1)</td>\n<td>báábí (2)</td>\n<td>: mugawanyi, ba-.<br/>分ける人, 分配する人,<br/>celui qui partage, etc.</td>\n</tr>\n<tr>\n<td>búábí (14)</td>\n<td>: bugawanyi, -.<br/>分割, 分配,<br/>partage, division, distribution.</td>\n</tr>\n<tr>\n<td>kúábáná (ass.)</td>\n<td>: kugawanyana.<br/>分けあう,<br/>se partager entre soi.</td>\n</tr>\n<tr>\n<td>búábane (14)</td>\n<td>: sehemu kisha kugawanyana.<br/>分け前,<br/>part, portion, lot.</td>\n</tr>\n<tr>\n<td>kúábwá (pass.)</td>\n<td>: kugawanywa.<br/>分けられる, 分配される,<br/>être partagé, etc.</td>\n</tr>\n<tr>\n<td>kúábibwá (pass.)</td>\n<td>: syn. du précédent.</td>\n</tr>\n<tr>\n<td>kúábányá (ass. + caus.)</td>\n<td>: plus ou moins syn. de <i>kúábá</i>.</td>\n</tr>\n<tr>\n<td>kúábúlá (tr.)</td>\n<td>: kugawanya kwa kupana ovyo ovyo.<br/>惜げもなく人に分け与える,<br/>distribuer libéralement.</td>\n</tr>\n<tr>\n<td>-²áb-² kúábá</td>\n<td>: kuowesha.<br/>娘を嫁に出す,<br/>marier sa fille, la donner en mariage.</td>\n</tr>\n<tr>\n<td>kúábirá (appl.)</td>\n<td>: kuoweshea.<br/>娘を(人)に嫁にやる,<br/>marier sa fille avec qn.</td>\n</tr>\n<tr>\n<td>-²áb¹ kabí (12)</td>\n<td>tswabí (13)</td>\n<td>: pingo, (ma-).<br/>くかたち[熱湯に手を入れても, あるいは真赤に焼けた鉄に触れても火傷しない者を無罪とする],<br/>êpreuve avec l'eau bouillante ou du fer rouge,<br/>ordalie.</td>\n</tr>\n<tr>\n<td>kúáhá ékabí</td>\n<td>: kulapisha kwa pingo.<br/>くかたちにかけて誓わせる,<br/>faire jurer par l'êpreuve.</td>\n</tr>\n<tr>\n<td>-²áb² kabí (12)</td>\n<td>tswabí (13)</td>\n<td>: aina ya muti ya dawa.<br/>[植]木の一種(葉として用いる),<br/>esp. de plante médicinale.</td>\n</tr>\n<tr>\n<td>-²ábúnyá (adj.)</td>\n<td>: (iko) sawa.<br/>～のような, ～らしい,<br/>comme, on dirait.</td>\n</tr>\n</table>", "skipped": false, "error": false, "bbox": [110.07999999999998, 153.34, 1199.3600000000001, 1649.34]}, {"polygon": [[595.2, 1740.97], [693.76, 1740.97], [693.76, 1769.02], [595.2, 1769.02]], "confidence": 0.9836030306882633, "label": "PageFooter", "raw_label": "Page-Footer", "reading_order": 1, "html": "<p>— 4 —</p>", "skipped": false, "error": false, "bbox": [595.2, 1740.97, 693.76, 1769.02]}], "image_bbox": [0.0, 0.0, 1280.0, 1870.0], "page": 3}, {"blocks": [{"polygon": [[176.64000000000001, 145.86], [503.04, 145.86], [503.04, 177.65], [176.64000000000001, 177.65]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 0, "html": "<p>abúnyá múndzú í nalólire kú.</p>", "skipped": false, "error": false, "bbox": [176.64000000000001, 145.86, 503.04, 177.65]}, {"polygon": [[627.2, 145.86], [1093.12, 145.86], [1093.12, 233.75], [627.2, 233.75]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 1, "html": "<p>: iko sawa mutu njoo ninaona ako.<br/>私は何か人のようなものを見た、<br/>c'est qc comme être humain que j'ai vu.</p>", "skipped": false, "error": false, "bbox": [627.2, 145.86, 1093.12, 233.75]}, {"polygon": [[176.64000000000001, 259.93], [352.0, 259.93], [352.0, 289.85], [176.64000000000001, 289.85]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 2, "html": "<p>lyabúnyá êmbe.</p>", "skipped": false, "error": false, "bbox": [176.64000000000001, 259.93, 352.0, 289.85]}, {"polygon": [[627.2, 259.93], [875.5200000000001, 259.93], [875.5200000000001, 345.95], [627.2, 345.95]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 3, "html": "<p>: iko sawa lipembe.<br/>これは角のようだ、<br/>on dirait une corne.</p>", "skipped": false, "error": false, "bbox": [627.2, 259.93, 875.5200000000001, 345.95]}, {"polygon": [[176.64000000000001, 372.13], [547.84, 372.13], [547.84, 403.92], [176.64000000000001, 403.92]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 4, "html": "<p>mwá mwanyí mwabúnyá múnolá.</p>", "skipped": false, "error": false, "bbox": [176.64000000000001, 372.13, 547.84, 403.92]}, {"polygon": [[627.2, 372.13], [1049.6, 372.13], [1049.6, 460.02], [627.2, 460.02]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 5, "html": "<p>: mwangu muko sawa humu.<br/>私の家の中もこんなものです、<br/>c'est qc comme ça dans ma maison.</p>", "skipped": false, "error": false, "bbox": [627.2, 372.13, 1049.6, 460.02]}, {"polygon": [[176.64000000000001, 486.2], [308.48, 486.2], [308.48, 516.12], [176.64000000000001, 516.12]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 6, "html": "<p>abúnyá (16)</p>", "skipped": false, "error": false, "bbox": [176.64000000000001, 486.2, 308.48, 516.12]}, {"polygon": [[627.2, 486.2], [894.7199999999999, 486.2], [894.7199999999999, 572.22], [627.2, 572.22]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 7, "html": "<p>: kuna mara.<br/>恐らく、<br/>peut-être, sans doute.</p>", "skipped": false, "error": false, "bbox": [627.2, 486.2, 894.7199999999999, 572.22]}, {"polygon": [[74.24000000000001, 596.53], [136.96, 596.53], [136.96, 628.32], [74.24000000000001, 628.32]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 8, "html": "<p>-ʔácì</p>", "skipped": false, "error": false, "bbox": [74.24000000000001, 596.53, 136.96, 628.32]}, {"polygon": [[172.8, 596.53], [284.16, 596.53], [284.16, 628.32], [172.8, 628.32]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 9, "html": "<p>lúáci (11)</p>", "skipped": false, "error": false, "bbox": [172.8, 596.53, 284.16, 628.32]}, {"polygon": [[403.2, 596.53], [515.84, 596.53], [515.84, 628.32], [403.2, 628.32]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 10, "html": "<p>ngáci (10)</p>", "skipped": false, "error": false, "bbox": [403.2, 596.53, 515.84, 628.32]}, {"polygon": [[627.2, 596.53], [1168.64, 596.53], [1168.64, 714.34], [627.2, 714.34]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 11, "html": "<p>: muti murefu kidogo kwa kujenga musonge.<br/>円錐形の家(<i>káhumíró</i>)を建てるときにその骨組<br/>となる木、<br/>perche formant l'armature de hutte <i>káhumíró</i>.</p>", "skipped": false, "error": false, "bbox": [627.2, 596.53, 1168.64, 714.34]}, {"polygon": [[74.24000000000001, 738.65], [136.96, 738.65], [136.96, 768.5699999999999], [74.24000000000001, 768.5699999999999]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 12, "html": "<p>-áfú</p>", "skipped": false, "error": false, "bbox": [74.24000000000001, 738.65, 136.96, 768.5699999999999]}, {"polygon": [[172.8, 738.65], [266.24, 738.65], [266.24, 768.5699999999999], [172.8, 768.5699999999999]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 13, "html": "<p>cáfú (7)</p>", "skipped": false, "error": false, "bbox": [172.8, 738.65, 266.24, 768.5699999999999]}, {"polygon": [[403.2, 738.65], [508.16, 738.65], [508.16, 768.5699999999999], [403.2, 768.5699999999999]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 14, "html": "<p>byáfú (8)</p>", "skipped": false, "error": false, "bbox": [403.2, 738.65, 508.16, 768.5699999999999]}, {"polygon": [[627.2, 738.65], [866.5600000000001, 738.65], [866.5600000000001, 826.54], [627.2, 826.54]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 15, "html": "<p>: yalala, -.<br/>ごみ捨て場、<br/>dépotoir, décharge.</p>", "skipped": false, "error": false, "bbox": [627.2, 738.65, 866.5600000000001, 826.54]}, {"polygon": [[74.24000000000001, 852.72], [136.96, 852.72], [136.96, 882.64], [74.24000000000001, 882.64]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 16, "html": "<p>-àfù</p>", "skipped": false, "error": false, "bbox": [74.24000000000001, 852.72, 136.96, 882.64]}, {"polygon": [[172.8, 852.72], [293.12, 852.72], [293.12, 882.64], [172.8, 882.64]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 17, "html": "<p>mwáfu (1)</p>", "skipped": false, "error": false, "bbox": [172.8, 852.72, 293.12, 882.64]}, {"polygon": [[403.2, 852.72], [495.36, 852.72], [495.36, 882.64], [403.2, 882.64]], "confidence": 0.9698005746537556, "label": "Text", "raw_label": "Text", "reading_order": 18, "html": "<p>báfu (2)</p>", "skipped": false, "error": false, "bbox": [403.2, 852.72, 495.36, 882.64]}, {"polygon": [[627.2, 852.72], [915.1999999999999, 852.72], [915.1999999999999, 938.74], [627.2, 9